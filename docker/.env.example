# Compose env defaults for host mounts
# Copy this file to docker/.env and edit absolute paths for your system.
# NOTE: Use absolute paths; ~ and $HOME are not expanded by Compose in .env files.
# If you prefer using $HOME, set these as shell exports instead of this file:
#   export MODELS_DIR="$HOME/.dora/models"
#   export HF_CACHE="$HOME/.cache/huggingface"

MODELS_DIR=/home/youruser/.dora/models
HF_CACHE=/home/youruser/.cache/huggingface

# Optional: map your repo into the container (so edits reflect live)
# Typically leave as the repo root relative to docker/.
REPO_DIR=..

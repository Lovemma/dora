# Example API keys and tokens (do not commit real secrets)
# Copy to ./.env and fill in values. docker/docker-compose.yml references this file via env_file.

# OpenAI examples (chatbot-openai-0905, browser demo)
OPENAI_API_KEY=sk-your-openai-key

# Alibaba Cloud examples (chatbot-alicloud-0908)
ALIBABA_CLOUD_API_KEY=sk-your-alicloud-key

# Optional: used when downloading gated models from Hugging Face
# HUGGING_FACE_HUB_TOKEN=hf_your_token

# Optional Jupyter config for the notebook service
# JUPYTER_PASSWORD=change-me
# JUPYTER_TOKEN=dora


# Alibaba Cloud MaaS Configuration Example
# Copy this file to alicloud_config.toml and add your API key

# Default model to use
default_model = "qwen-turbo"

# System prompt
system_prompt = "You are a helpful assistant powered by Alibaba Cloud AI models."

# Maximum conversation history exchanges to maintain
max_history_exchanges = 10

# Enable streaming for real-time response
enable_streaming = true

# Disable tools for this simple demo
enable_tools = false

# Alibaba Cloud Provider Configuration
[[providers]]
id = "alicloud"
kind = "alicloud"
# Using the DashScope API endpoint for OpenAI compatibility
api_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# API key from environment variable (recommended)
# Set it with: export ALIBABA_CLOUD_API_KEY="sk-your-key-here"
api_key = "env:ALIBABA_CLOUD_API_KEY"
# Alternatively, you can set the API key directly (not recommended for production)
# api_key = "sk-YOUR-API-KEY-HERE"
proxy = false

# Model Configurations - Alibaba Cloud offers various models

# Qwen Series (Alibaba's own models)
[[models]]
id = "qwen-turbo"
route = { provider = "alicloud", model = "qwen-turbo" }

[[models]]
id = "qwen-plus"
route = { provider = "alicloud", model = "qwen-plus" }

[[models]]
id = "qwen-max"
route = { provider = "alicloud", model = "qwen-max" }

# DeepSeek Models
[[models]]
id = "deepseek-chat"
route = { provider = "alicloud", model = "deepseek-chat" }

[[models]]
id = "deepseek-coder"
route = { provider = "alicloud", model = "deepseek-coder" }

# Moonshot (Kimi) Models  
[[models]]
id = "moonshot-v1-8k"
route = { provider = "alicloud", model = "moonshot-v1-8k" }

[[models]]
id = "moonshot-v1-32k"
route = { provider = "alicloud", model = "moonshot-v1-32k" }

[[models]]
id = "moonshot-v1-128k"
route = { provider = "alicloud", model = "moonshot-v1-128k" }

# Yi Series Models
[[models]]
id = "yi-34b-chat"
route = { provider = "alicloud", model = "yi-34b-chat" }

# Baichuan Models
[[models]]
id = "baichuan2-turbo"
route = { provider = "alicloud", model = "baichuan2-turbo" }